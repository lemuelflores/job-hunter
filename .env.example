AUTOM_API_KEY=
JOB_HUNTER_MODEL=gpt-6-luna
JOB_HUNTER_EFFORT=medium
FIRECRAWL_URL=http://127.0.0.1:3002
REDIS_URL=redis://127.0.0.1:6379
# Five-field node-cron expression, UTC; no immediate fetch on startup.
FETCH_CRON="0 * * * *"
# Set a private password before starting Compose; use the same value when migrating an existing stack.
POSTGRES_PASSWORD=
