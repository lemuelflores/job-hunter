[Unit]
Description=Job Hunter review worker
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Replace these paths with your checkout and stable Node.js 22.18+ executable.
WorkingDirectory=/path/to/job-hunter
ExecStart=/path/to/node /path/to/job-hunter/dist/cli.js worker
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
