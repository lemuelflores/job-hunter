{
  // Where you live. The reviewer checks remote hiring eligibility from here.
  "location": "Philippines",

  // Each group generates separate searches; alternatives within a group use OR.
  // Geography is required: listings without these terms may be missed.
  "searchLocations": [
    ["Philippines", "Manila"],
    ["APAC", "Asia", "Southeast Asia"],
    ["worldwide", "anywhere", "global", "international"]
  ],

  // All role groups are combined into ONE OR clause, not separate searches.
  // Every query also requires (developer OR engineer).
  "roleGroups": [
    ["fullstack", "full stack", "full-stack"],
    ["backend", "back end", "back-end"],
    ["frontend", "front end", "front-end"],
    ["web"]
  ],

  // Separate searches per group. Terms can occur anywhere on the indexed page,
  // not just in the title; a listing only needs ONE alternative to match.
  "skillGroups": [
    ["Laravel", "PHP"],
    ["Vue", "Vue.js", "VueJS"],
    ["Nuxt", "Nuxt.js", "NuxtJS"],
    ["Node.js", "NodeJS", "Node"],
    ["JavaScript", "TypeScript"]
  ]
}
