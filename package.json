{
  "name": "job-hunter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "job-hunter": "src/entrypoints/cli.ts"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:queue": "node --test test/workers.queue.mjs",
    "test:web:browser": "pnpm build && node --test test/web.browser.mjs",
    "job-hunter": "node src/entrypoints/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "@tanstack/virtual-core": "3.19.7",
    "alpinejs": "3.17.5",
    "bullmq": "6.3.17",
    "citty": "^0.2.2",
    "entities": "^8.1.0",
    "html-to-text": "^10.0.1",
    "node-cron": "^4.6.0",
    "redis": "6.3.0",
    "valibot": "1.5.0"
  }
