{
  "name": "job-hunter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "job-hunter": "dist/entrypoints/cli.js"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "build": "tsc -p tsconfig.profile.json && tsc -p tsconfig.json && cp src/web/index.html dist/web/index.html && cp node_modules/alpinejs/dist/cdn.min.js dist/web/alpine.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:queue": "pnpm build && node --test test/workers.queue.mjs",
    "job-hunter": "node dist/entrypoints/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "alpinejs": "3.17.5",
    "bullmq": "6.3.17",
    "citty": "^0.2.2",
    "entities": "^8.1.0",
    "html-to-text": "^10.0.1",
    "node-cron": "^4.6.0",
    "redis": "6.3.0",
    "valibot": "1.5.0"
  }
}
